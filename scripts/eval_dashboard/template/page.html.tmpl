<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>__TITLE__</title>
<style>
  /* One set of visual tokens for the four pages this template renders --
     the Brief, the PR view, the Grid and the Cases page -- so they read as
     one site. */
  .viz-root {
    color-scheme: light;
    --surface-0:#f7f8f9; --surface-1:#ffffff; --surface-2:#f1f2f0; --line:#e9ebe6; --line-2:#d7d9d2;
    --text-primary:#151a24; --text-secondary:#3f464d; --text-muted:#8b9296;
    --accent:#0053e2; --accent-soft:#e8effc; --hl:#ffc220; --hl-soft:#fff4d6;
    --good:#0ca30c; --good-text:#04720a; --good-bg:#e6f5e6;
    --crit:#d03b3b; --crit-text:#a01f1f; --crit-bg:#fbe9e9;
    --warn:#fab219; --warn-text:#7a5200; --warn-bg:#fdf3d7;
    --ser:#ec835a; --ser-text:#9c3f14; --ser-bg:#fdeee6;
    --skip-bg:#eef0ee;
    --shadow:0 1px 2px rgba(21,26,36,.05), 0 8px 24px -12px rgba(21,26,36,.10);
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .viz-root {
      color-scheme: dark;
      --surface-0:#0a0a0c; --surface-1:#161618; --surface-2:#212126; --line:#27272a; --line-2:#3a3a42;
      --text-primary:#fbfaf7; --text-secondary:#c9ced6; --text-muted:#a9afba;
      --accent:#8b5cf6; --accent-deep:#6e00ff; --accent-soft:#241740; --accent-link:#c4b5fd; --hl:#f59e0b; --hl-soft:#331f05;
      --good-text:#5fd35f; --good-bg:#14320f; --crit-text:#ef8080; --crit-bg:#3a1515;
      --warn-text:#fcd34d; --warn-bg:#331f05; --ser-text:#f2a380; --ser-bg:#38200f;
      --skip-bg:#212126;
      --shadow:0 1px 2px rgba(0,0,0,.6), 0 10px 30px -12px rgba(0,0,0,.7);
    }
  }
  :root[data-theme="dark"] .viz-root {
    color-scheme: dark;
    --surface-0:#0a0a0c; --surface-1:#161618; --surface-2:#212126; --line:#27272a; --line-2:#3a3a42;
    --text-primary:#fbfaf7; --text-secondary:#c9ced6; --text-muted:#a9afba;
    --accent:#8b5cf6; --accent-deep:#6e00ff; --accent-soft:#241740; --accent-link:#c4b5fd; --hl:#f59e0b; --hl-soft:#331f05;
    --good-text:#5fd35f; --good-bg:#14320f; --crit-text:#ef8080; --crit-bg:#3a1515;
    --warn-text:#fcd34d; --warn-bg:#331f05; --ser-text:#f2a380; --ser-bg:#38200f;
    --skip-bg:#212126;
    --shadow:0 1px 2px rgba(0,0,0,.6), 0 10px 30px -12px rgba(0,0,0,.7);
  }
  * { box-sizing:border-box; margin:0; }
  body.viz-root { background:var(--surface-0); color:var(--text-primary);
    font:15.5px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased; }
  .wrap { max-width:760px; margin:0 auto; padding:0 24px 80px; }
  /* The two table pages need the width; the prose pages read better narrow. */
  body[data-page="grid"] .wrap, body[data-page="cases"] .wrap { max-width:1120px; }
  a { color:var(--accent-link,var(--accent)); text-decoration:none; font-weight:600; }
  a:hover { text-decoration:underline; }
  b, strong { font-weight:650; }
  code { font:600 12.5px ui-monospace,SFMono-Regular,Menlo,monospace; color:var(--text-secondary);
    background:var(--surface-2); padding:1px 5px; border-radius:4px; }

  .top { position:sticky; top:0; z-index:5; background:var(--surface-1); border-bottom:1px solid var(--line); }
  .top-in { max-width:1120px; margin:0 auto; padding:13px 28px; display:flex; align-items:center; gap:16px; }
  .brand { font-size:15px; font-weight:750; letter-spacing:-.01em; display:flex; align-items:center; gap:9px; }
  .brand .logo { width:22px; height:22px; border-radius:6px; background:var(--accent-deep,var(--accent)); display:inline-flex;
    align-items:center; justify-content:center; color:#fff; font-size:12px; font-weight:800; }
  .nav { display:flex; gap:20px; margin-left:16px; }
  .nav a { color:var(--text-muted); font-size:13px; font-weight:650; padding:4px 0; border-bottom:2px solid transparent; }
  .nav a.on { color:var(--text-primary); border-bottom-color:var(--accent); }
  .top .meta { margin-left:auto; font-size:12px; color:var(--text-muted); font-weight:500; }
  .fresh { font-weight:650; white-space:nowrap; }
  .fresh.stale { background:var(--hl-soft); border:1px solid var(--hl);
    border-radius:6px; padding:2px 8px; color:var(--text-primary); font-weight:750; }

  .sec { margin-top:34px; }
  .sec.head { margin-top:36px; }
  .sec h2 { font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--accent-link,var(--accent));
    margin-bottom:10px; font-weight:750; }
  h1 { font-size:27px; line-height:1.25; margin:14px 0 8px; font-weight:700; letter-spacing:-.02em; }
  .crumb { margin-top:28px; color:var(--text-muted); font-size:13px; }
  .crumb + h1 { margin-top:6px; }
  .lede { color:var(--text-secondary); font-size:15px; }
  .mut { color:var(--text-muted); }
  .small { font-size:12.5px; }
  .stale { color:var(--warn-text); font-weight:600; }
  p { margin-bottom:8px; }

  /* state pill and the banner */
  .hpill { display:inline-block; font-size:12px; font-weight:750; padding:3px 10px; border-radius:99px; letter-spacing:.02em; white-space:nowrap; }
  .hs-green { background:var(--good-bg); color:var(--good-text); }
  .hs-amber { background:var(--warn-bg); color:var(--warn-text); }
  .hs-red { background:var(--crit-bg); color:var(--crit-text); }
  .hs-past { background:var(--skip-bg); color:var(--text-secondary); }
  .banner { margin-top:22px; display:flex; gap:12px; align-items:flex-start; background:var(--surface-1); border:1px solid var(--line);
    border-left:4px solid var(--line-2); border-radius:10px; padding:12px 16px; font-size:14.5px; box-shadow:var(--shadow); }
  .banner.hs-green { border-left-color:var(--good); background:var(--surface-1); color:var(--text-primary); }
  .banner.hs-amber { border-left-color:var(--warn); background:var(--surface-1); color:var(--text-primary); }
  .banner.hs-red { border-left-color:var(--crit); background:var(--surface-1); color:var(--text-primary); }
  .banner .hpill { margin-top:3px; }
  .banner .right { margin-left:auto; color:var(--text-muted); font-size:13px; white-space:nowrap; }

  /* yes/no facts */
  ul.facts { list-style:none; padding:0; }
  .facts li { padding:9px 0; border-bottom:1px solid var(--line); display:flex; gap:12px; align-items:flex-start; }
  .facts li:last-child { border:0; }
  .facts .y { color:var(--good-text); font-weight:750; min-width:30px; }
  .facts .n { color:var(--crit-text); font-weight:750; min-width:30px; }

  /* what the agent saw */
  .q { border-left:3px solid var(--accent); padding:6px 14px; font-style:italic; background:var(--surface-1); border-radius:0 8px 8px 0; margin-bottom:10px; }
  .q small { display:block; font-style:normal; color:var(--text-muted); font-size:13px; margin-top:6px; }
  .reason { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; color:var(--warn-text); background:var(--surface-1);
    border:1px solid var(--line); padding:8px 10px; border-radius:6px; margin:10px 0 6px; white-space:pre-wrap; word-break:break-word; }
  ul.merges { list-style:none; padding:0; }
  .merges li { padding:5px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .merges li:last-child { border:0; }
  .merges .mut { display:inline-block; min-width:150px; }

  .next { margin-top:34px; background:var(--accent-soft); border:1px solid var(--accent); border-radius:12px; padding:16px 20px; }
  .next h2 { margin-bottom:8px; }
  .next ul { margin:0; padding-left:18px; }
  .next li { margin:6px 0; font-size:15px; }

  /* runs list */
  .runs { display:flex; flex-direction:column; gap:4px; }
  .runrow { display:grid; grid-template-columns:64px 150px 76px 1fr; gap:10px; align-items:start; padding:8px 12px; border-radius:8px;
    background:var(--surface-1); border:1px solid var(--line); border-left:4px solid var(--line-2); color:var(--text-primary); font-weight:500; font-size:13.5px; }
  .runrow:hover { text-decoration:none; background:var(--surface-2); }
  .runrow.v-red { border-left-color:var(--crit); }
  .runrow.v-infra { border-left-color:var(--warn); }
  .runrow.v-green { border-left-color:var(--good); }
  .rpr { font-weight:750; }
  .rwhen, .rproj { color:var(--text-muted); }
  .rcases { display:flex; flex-wrap:wrap; gap:4px; align-items:center; }
  .chip { font:600 11px ui-monospace,SFMono-Regular,Menlo,monospace; padding:1px 7px; border-radius:6px; background:var(--skip-bg); color:var(--text-secondary); }
  .chip.hit { background:var(--crit-bg); color:var(--crit-text); }
  .chip.miss { background:var(--warn-bg); color:var(--warn-text); }
  .chip.ok { background:var(--good-bg); color:var(--good-text); font-family:inherit; }
  .chip.inf { background:var(--ser-bg); color:var(--ser-text); font-family:inherit; }

  /* numbers */
  .tiles { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-top:12px; }
  .tile { background:var(--surface-1); border:1px solid var(--line); border-radius:12px; padding:14px 16px 12px; box-shadow:var(--shadow); }
  .tile .k { font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--text-muted); }
  .tile .v { font:800 26px/1.2 'DM Mono',ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:-.02em; margin-top:6px; font-variant-numeric:tabular-nums; }
  .tile .v small { font-size:12px; color:var(--text-muted); font-weight:600; margin-left:4px; }
  .tile .d2 { font-size:11.5px; color:var(--text-muted); margin-top:6px; font-weight:550; }
  @media (max-width:720px) { .tiles { grid-template-columns:repeat(2,1fr); } .runrow { grid-template-columns:56px 1fr; } }

  /* PR view cards */
  .case { background:var(--surface-1); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:12px; box-shadow:var(--shadow); }
  .case .hd { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .case h3 { font:500 15px ui-monospace,SFMono-Regular,Menlo,monospace; }
  .tag { font-size:11px; font-weight:750; padding:2px 9px; border-radius:6px; white-space:nowrap; }
  .tag.shared { background:var(--warn-bg); color:var(--warn-text); }
  .tag.yours { background:var(--crit-bg); color:var(--crit-text); }
  .tag.storm, .tag.held { background:var(--ser-bg); color:var(--ser-text); }
  .tag.unclear { background:var(--skip-bg); color:var(--text-secondary); }
  .case .sub { color:var(--text-muted); font-size:13.5px; margin-top:4px; }
  .case .reason { margin-top:10px; }
  .quote { border-left:3px solid var(--accent); padding:4px 12px; font-style:italic; margin-top:10px; font-size:14px; }
  .do { margin-top:10px; font-size:14px; }
  .links { margin-top:8px; font-size:13px; display:flex; gap:14px; flex-wrap:wrap; }
  .passed { color:var(--text-muted); font-size:14px; }
  .passed span { display:inline-block; background:var(--good-bg); color:var(--good-text); font:600 12px ui-monospace,SFMono-Regular,Menlo,monospace;
    padding:2px 8px; border-radius:6px; margin:2px 4px 2px 0; }
  .passed span.held { background:var(--skip-bg); color:var(--text-secondary); }

  /* controls shared by the Grid and the Cases page: one row of chips */
  .ctl { display:flex; gap:8px; align-items:center; margin:18px 0 12px; font-size:13px; color:var(--text-muted); flex-wrap:wrap; }
  .ctl .sep { margin:0 4px; }
  .ctl button { font:inherit; font-size:12.5px; font-weight:600; padding:4px 11px; border-radius:99px; border:1px solid var(--line);
    background:var(--surface-1); color:var(--text-muted); cursor:pointer; }
  .ctl button.on { border-color:var(--accent); color:var(--text-primary); background:var(--accent-soft); }
  .ctl button:hover { color:var(--text-primary); }

  /* the Cases page */
  table.cases { width:100%; border-collapse:collapse; background:var(--surface-1); border:1px solid var(--line); border-radius:12px;
    overflow:hidden; box-shadow:var(--shadow); font-size:13.5px; }
  table.cases th { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-muted); text-align:left;
    padding:10px 12px; border-bottom:1px solid var(--line); font-weight:700; white-space:nowrap; }
  table.cases td { padding:9px 12px; border-bottom:1px solid var(--line); vertical-align:middle; }
  table.cases tr:last-child td { border-bottom:0; }
  table.cases tr.grp td { background:var(--surface-2); font-size:11px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--accent-link,var(--accent)); padding:6px 12px; font-weight:750; }
  table.cases tr.hl td { background:var(--accent-soft); }
  table.cases tr.dim td { color:var(--text-muted); }
  td.nm { font:500 13px ui-monospace,SFMono-Regular,Menlo,monospace; white-space:nowrap; }
  td.nm small { display:block; font:12px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; color:var(--text-muted); margin-top:2px; }
  .spark { display:flex; gap:2px; align-items:flex-end; height:18px; }
  .spark i { display:block; width:5px; height:100%; border-radius:1px; background:var(--good); opacity:.55; }
  .spark i.fail { background:var(--crit); opacity:1; }
  .spark i.partial { background:var(--crit); opacity:.45; }
  .spark i.infra { background:var(--accent); opacity:.55; }
  .rate { font:600 13px ui-monospace,SFMono-Regular,Menlo,monospace; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .rate small { font-weight:500; color:var(--text-muted); font-size:11px; margin-left:3px; }
  .rate.ok { color:var(--good-text); }
  .rate.warn { color:var(--warn-text); }
  .rate.bad { color:var(--crit-text); }
  .rate.none { color:var(--text-muted); font-weight:500; }
  .st { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px; border-radius:6px; white-space:nowrap; }
  .st.blocking { background:var(--good-bg); color:var(--good-text); }
  .st.held_out, .st.retired { background:var(--skip-bg); color:var(--text-secondary); }
  .st.demoted { background:var(--warn-bg); color:var(--warn-text); }
  .st.nightly_only { background:var(--hl-soft); color:var(--warn-text); }
  table.cases tr.main td { border-bottom:0; padding-bottom:4px; }
  table.cases tr.why td { padding:0 12px 10px 12px; font-size:12.5px; color:var(--text-secondary); }
  table.cases tr.why b { color:var(--text-primary); }
  table.cases .lbl { font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-right:4px; }
  /* A flex row whose reason may shrink to nothing: a long reason must never
     widen the table (auto layout would otherwise size the column to it). */
  .lf { display:flex; gap:8px; align-items:baseline; min-width:0; }
  .lf > span { white-space:nowrap; }
  .rsn { flex:0 1 auto; min-width:0; max-width:560px; font:500 11.5px ui-monospace,SFMono-Regular,Menlo,monospace; color:var(--warn-text);
    background:var(--surface-2); padding:1px 8px; border-radius:6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .more td { color:var(--text-muted); font-size:13px; }

  /* the Grid */
  .gridwrap { background:var(--surface-1); border:1px solid var(--line); border-radius:12px; padding:16px 18px 14px; box-shadow:var(--shadow); }
  /* Only the grid scrolls; the legend and the merge list stay in view. */
  .gscroll { overflow-x:auto; }
  /* Sized to its tracks, not the box: a busy window overflows the card and
     scrolls, and the markers' percentages have to measure the whole grid. */
  .g { display:grid; column-gap:3px; row-gap:0; align-items:center; position:relative; --namew:250px; --colmin:14px; width:max-content; min-width:100%; }
  .g .hd { font:500 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace; color:var(--text-muted); white-space:nowrap; overflow:hidden;
    writing-mode:vertical-rl; transform:rotate(180deg); height:92px; justify-self:center; padding-top:2px; }
  .g .hd b { color:var(--text-primary); font-weight:600; }
  .g .grp { grid-column:1; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--accent-link,var(--accent)); padding:10px 0 2px; font-weight:750; white-space:nowrap; }
  .g .grp-fill { grid-column:2/-1; }
  .g .nm { font:500 12.5px ui-monospace,SFMono-Regular,Menlo,monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding-right:8px; }
  /* The names stay put while the columns scroll. */
  .g .nm, .g .grp, .g .more { position:sticky; left:0; z-index:2; background:var(--surface-1); align-self:stretch; display:flex; align-items:center; }
  .g .nm.h { color:var(--text-muted); }
  .g .nm.lk { color:var(--accent-link,var(--accent)); }
  .g .nm small { color:var(--text-muted); font-size:11px; margin-left:6px; font-family:inherit; }
  .g .c { height:22px; margin:1.5px 0; border-radius:4px; border:0; padding:0; cursor:pointer; background:var(--skip-bg); }
  .g .c:hover { outline:2px solid var(--line-2); outline-offset:1px; }
  .g .c.pass { background:var(--good); opacity:.55; }
  .g .c.fail { background:var(--crit); }
  .g .c.partial { background:var(--crit); opacity:.45; }
  .g .c.infra { background:var(--accent); opacity:.55; }
  .g .c.died { background:transparent; border:1.5px solid var(--text-muted); cursor:default; }
  .g .c.running { background:repeating-linear-gradient(45deg, transparent 0 4px, var(--line-2) 4px 6px); cursor:default; }
  .g .c.none { background:var(--surface-2); cursor:default; }
  .g .c.sel { outline:2px solid var(--text-primary); outline-offset:1px; opacity:1; }
  .g .more { grid-column:1; font-size:12.5px; color:var(--text-muted); padding:6px 0 2px; white-space:nowrap; }
  .g .more button { font:inherit; color:var(--accent-link,var(--accent)); background:none; border:0; cursor:pointer; padding:0; font-weight:600; }
  .mk { position:absolute; top:0; bottom:0; width:2px; pointer-events:none; opacity:.9; }
  .mk.merge { background:var(--accent-link,var(--accent)); opacity:.6; }
  .mk.incident { background:var(--crit); }
  .mk.recovered { background:var(--good); }
  .mkl { position:absolute; transform:translateX(-50%); font:500 10.5px ui-monospace,SFMono-Regular,Menlo,monospace; white-space:nowrap;
    padding:1px 6px; border-radius:4px; }
  .mkl.merge { background:var(--accent-soft); color:var(--accent-link,var(--accent)); }
  .mkl.incident { background:var(--crit-bg); color:var(--crit-text); }
  .mkl.recovered { background:var(--good-bg); color:var(--good-text); }
  .legend { display:flex; gap:16px; color:var(--text-muted); font-size:12px; margin-top:12px; flex-wrap:wrap; }
  .legend i { display:inline-block; width:11px; height:11px; border-radius:3px; vertical-align:-1px; margin-right:5px; background:var(--skip-bg); }
  .legend i.pass { background:var(--good); opacity:.55; }
  .legend i.fail { background:var(--crit); }
  .legend i.partial { background:var(--crit); opacity:.45; }
  .legend i.infra { background:var(--accent); opacity:.55; }
  .legend i.died { background:transparent; border:1.5px solid var(--text-muted); }
  .legend i.running { background:repeating-linear-gradient(45deg, transparent 0 3px, var(--line-2) 3px 5px); }
  .legend i.mkmerge { background:var(--accent-link,var(--accent)); width:3px; border-radius:0; }
  .legend i.mkincident { background:var(--crit); width:3px; border-radius:0; }
  .legend i.mkrecovered { background:var(--good); width:3px; border-radius:0; }
  .detail { margin-top:14px; background:var(--surface-1); border:1px solid var(--accent); border-radius:12px; padding:16px 18px; box-shadow:var(--shadow); }
  .detail h3 { font-size:15px; font-weight:600; display:flex; gap:10px; align-items:baseline; flex-wrap:wrap; }
  .detail h3 code { font-size:14px; }
  .detail .close { margin-left:auto; font:inherit; font-size:13px; color:var(--text-muted); background:none; border:0; cursor:pointer; }
  .detail .sub { color:var(--text-muted); font-size:13px; margin:4px 0 10px; }

  /* the Brief's release table */
  table.rel { width:100%; border-collapse:collapse; background:var(--surface-1); border:1px solid var(--line); border-radius:12px; overflow:hidden; font-size:13.5px; box-shadow:var(--shadow); }
  table.rel th { text-align:left; font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.06em; font-weight:700; padding:9px 12px; border-bottom:1px solid var(--line); }
  table.rel td { padding:9px 12px; border-bottom:1px solid var(--line); vertical-align:middle; }
  table.rel tr:last-child td { border-bottom:0; }
  table.rel td.num { font-variant-numeric:tabular-nums; font-weight:600; color:var(--text-secondary); }
  table.rel .tnote { font-size:12px; color:var(--text-muted); margin-top:1px; }
  .pill { display:inline-flex; align-items:center; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:750; letter-spacing:.03em; }
  .p-pass { background:var(--good-bg); color:var(--good-text); }

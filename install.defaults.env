# ==============================================================================
# kube-agents install defaults
# ==============================================================================
# Every value an install gets for saying nothing, and nothing else. This file
# does one job: hold the defaults. It is checked in, it is not configuration,
# and it is not the file you edit — that is `install.env`, from
# `install.env.example`.
#
# Precedence, lowest to highest:
#
#     install.defaults.env  →  an exported environment variable  →  install.env
#     →  a command-line flag
#
# `install.env` is sourced with `set -a`, so a key it carries overwrites an
# exported variable of the same name rather than deferring to it. A flag is what
# overrides a recorded value for a single run; `KEY=value ./install.sh` does not.
# NAMESPACE is the one key an exported variable never sets: the front doors
# clear it before reading the file (kubectl tooling exports that name).
#
# Sourced by install.sh, upgrade.sh and uninstall.sh (through
# `scripts/installer/installer_common.sh`) before `install.env`, and by
# `terraform/examples/full-install/lifecycle.sh`, which never sees
# `install.env` and needs the few defaults it must agree with the front doors on.
#
# Why a file rather than constants next to the code that reads them: an inline
# `${VAR:-false}` at each point of use is a second copy of the default, and
# copies drift. That is how the installer's permission-set default once
# disagreed with the provisioner's, and how the chart sat on LiteLLM v1.92.0 for
# a release after the kustomize base moved to v1.95.0. One home, no copies.
#
# Why the values are NOT pre-filled into `install.env.example`: a default copied
# into an operator's own file freezes at the moment they copied it and never
# tracks a release again. The example lists them commented out instead, so the
# shape is discoverable and the value still comes from here.
#
# These are DEFAULT_-prefixed shell assignments, sourced without `set -a`, so
# they stay shell variables and never leak into the environment the agent or
# Terraform sees. Do not put install configuration here; it would apply to every
# install rather than yours.
# ==============================================================================

# ─── Where an install goes ────────────────────────────────────────────────────
DEFAULT_CLUSTER_NAME="platform-agent-host"
DEFAULT_REGION="us-central1"

# Autopilot, because it is the shape this project is developed and validated
# against: the autopush and staging installs already run it, the chart needs no
# node pool, and gVisor comes from Autopilot's built-in RuntimeClass rather than
# a dedicated pool. Standard remains a first-class choice and is what
# --cluster-mode=standard, CLUSTER_MODE=standard, or a hand-written tfvars
# selects; it is also required for a zonal install, which Autopilot cannot do.
#
# This decides ONE thing: the shape a FRESH install creates. It never reaches a
# cluster that already exists -- see write_tfvars_from_state, where every branch
# with a live cluster takes its mode from the probe instead.
DEFAULT_CLUSTER_MODE="autopilot"

# ─── Model provider ───────────────────────────────────────────────────────────
DEFAULT_MODEL_PROVIDER="gemini"

# The model each provider serves when MODEL_DEFAULT_NAME says nothing
# (default_model_for_provider; vertex_ai shares the Gemini one). The chart's
# litellm.yaml carries the same table for a hand-driven Helm install and cannot
# source this file; tests/test_installer_common.py pins the two equal.
DEFAULT_MODEL_GEMINI="gemini-3.5-flash"
DEFAULT_MODEL_OPENAI="gpt-5.4"
DEFAULT_MODEL_ANTHROPIC="claude-opus-5"

# The Secret Manager secret install.sh reads a Gemini API key from when neither
# the flag nor install.env carries one.
DEFAULT_GEMINI_API_KEY_SECRET_NAME="gemini-api-key"

# Vertex serves each model from its own subset of locations, and the cluster's
# region is usually not one of them -- gemini-3.5-flash, the vertex_ai default,
# is not served from us-central1 (DEFAULT_REGION), so a region-derived default
# 404s on a stock install. The global endpoint serves the first-party Gemini
# models from wherever has capacity, which is the only default that works
# without knowing the cluster's region. Two reasons to override it: it gives no
# in-region ML processing guarantee, and a Model Garden partner model (Claude,
# Llama, Mistral) may be served only from specific regions. Which locations
# serve which model:
# https://docs.cloud.google.com/vertex-ai/generative-ai/docs/learn/locations
DEFAULT_VERTEX_LOCATION="global"

# An install serving from its own project can enable the API and grant the
# gateway's role itself, and for a serving project it administers the same is
# true. Only a serving project the installing identity holds no IAM on needs
# the grant made by hand, so that is the opt-out rather than the default.
DEFAULT_VERTEX_MANAGE_SERVING_PROJECT="true"

# ─── Identity and namespace ──────────────────────────────────────────────────
# The Kubernetes namespace the release installs into. The chart hard-wires the
# agent's model-gateway endpoint to this namespace (see the chart's values.yaml),
# so nothing but CI, which renders install.env from a GitHub environment that
# may name another one, has a reason to change it.
DEFAULT_NAMESPACE="kubeagents-system"

# The Google service accounts an install creates. Each name is one fixed name
# per PROJECT while Terraform state is kept per CLUSTER, so a second install in
# the same project must give itself different ones (PLATFORM_AGENT_GSA_NAME and
# friends in install.env) or its first apply 409s on the account the first
# install already owns. Changing a name on an EXISTING install replaces the
# account: account_id is ForceNew on google_service_account.
DEFAULT_PLATFORM_AGENT_GSA_NAME="kubeagents-platform-gsa"
DEFAULT_GITHUB_MINTER_GSA_NAME="kubeagents-github-minter-gsa"
DEFAULT_LITELLM_GSA_NAME="kubeagents-litellm-gsa"

# Cloud KMS key ring and key for GKE database encryption (CMEK). One pair
# serves every cluster in a project: key rings cannot be deleted, so a second
# install adopts the first one's rather than creating its own. Read by both
# halves of the install -- the gke-cluster module on a create, and install.sh's
# gcloud step on a cluster that already exists -- so that the two never encrypt
# with different keys.
DEFAULT_GKE_DB_KMS_KEYRING="platform-agent-keyring"
DEFAULT_GKE_DB_KMS_KEY="k8s-secret-encryption-key"

# ─── Agent permissions, isolation, and features ───────────────────────────────
DEFAULT_PERMISSION_SET="read-only"
# On by default: the agent runs untrusted model output, and GKE Sandbox is the
# boundary that contains it. --gvisor=false opts out.
DEFAULT_ENABLE_GVISOR="true"
DEFAULT_ENABLE_WEBUI="false"
DEFAULT_USER_PROFILE_ENABLED="false"
DEFAULT_ENABLE_GKE_BACKUP_PLAN="false"
# The optional AgentPlugins, off because each adds GCP resources an install did
# not ask for: a Pub/Sub topic with its grants, and a log sink with a stockout
# alerts topic and subscription.
DEFAULT_ENABLE_PUBSUB_PLATFORM="false"
DEFAULT_ENABLE_STOCKOUT_INVESTIGATOR="false"
DEFAULT_MEMORY_ENABLED="false"
# Secrets are written into terraform.tfvars by default. false sends them to
# Terraform as TF_VAR_* instead, and later runs recover them from the live
# platform-agent-secrets Secret.
DEFAULT_PERSIST_SECRETS_ON_DISK="true"

# `file` because it is what every install got before the searchable store
# existed, so an upgrade that says nothing keeps the store it already has, and
# no install grows a Postgres database it never asked for.
DEFAULT_MEMORY="file"

# The provider name `file` translates to, and the one the CRD, common.sh and
# both profiles' config.yaml already default to with no install to ask. Only
# reached when neither MEMORY_PROVIDER nor MEMORY is set at all.
DEFAULT_MEMORY_PROVIDER="multiuser_memory"

# The sandbox node pool the gke-cluster module creates on a Standard cluster.
# Autopilot has no pool to name. write_tfvars_from_state applies this default
# itself, so install.sh deliberately does not export a value over it.
DEFAULT_GVISOR_POOL_NAME="gvisor-pool"

# ─── Chat integrations ────────────────────────────────────────────────────────
DEFAULT_GOOGLE_CHAT_ENABLED="false"
DEFAULT_SLACK_ENABLED="false"
DEFAULT_GOOGLE_CHAT_MODE="default"
DEFAULT_CHAT_TOPIC_NAME="platform-agent-chat-events"
DEFAULT_CHAT_SUB_NAME="platform-agent-chat-events-sub"

# ─── GitOps repository and the token minter ───────────────────────────────────
DEFAULT_GITOPS_REPO="gke-fleet-iac"
DEFAULT_KMS_KEYRING="github-token-minter-keyring"
DEFAULT_KMS_KEY="github-token-minter-key"

# ─── Terraform state ──────────────────────────────────────────────────────────
# Where an install keeps its Terraform state in GCS, derived from the install
# coordinates alone so uninstall.sh and upgrade.sh find it from a fresh clone.
# KUBE_AGENTS_STATE_BUCKET names the bucket; its default is the sentinel that
# derives one as <PROJECT_ID><suffix>. The prefix under it is <root>/<CLUSTER_NAME>
# unless KUBE_AGENTS_STATE_PREFIX names another. installer_common.sh derives
# both for the front doors and lifecycle.sh derives them again from these same
# values for a hand-driven run, so the two cannot name different objects.
DEFAULT_KUBE_AGENTS_STATE_BUCKET="auto"
DEFAULT_TF_STATE_BUCKET_SUFFIX="-kube-agents-tfstate"
DEFAULT_TF_STATE_PREFIX_ROOT="kube-agents"

# ─── Container registry ───────────────────────────────────────────────────────
# All kube-agents images (k8s-operator, platform-agent, credential-proxy,
# replay-proxy) default to this public registry prefix. Behind-the-firewall
# installs set REGISTRY_PREFIX in install.env to pull mirrored images instead.
DEFAULT_REGISTRY_PREFIX="ghcr.io/gke-labs/kube-agents"

# ─── Helm rollouts ───────────────────────────────────────────────────────────
# Timeout (in seconds) passed to helm_release for cert-manager and kube-agents.
# Defaults to 600s (10 minutes).
DEFAULT_HELM_TIMEOUT="600"

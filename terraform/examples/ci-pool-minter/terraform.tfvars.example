# One pool project per apply, each with its OWN STATE — the resources are
# per-project and the KMS key rings cannot be shared. Do not onboard a second
# project by editing this file and re-applying over the first project's state:
# project_id is force-new on the minter GSA, so that plan destroys the first
# project's minter. Give the second project its own workspace or backend prefix
# first; see the Usage section of README.md.
#
# Fill both values for the ONE project being onboarded. The project-to-repo
# mapping lives in gitops_repo_for_project() in hack/ci-deploy.sh and is
# documented in docs/site/src/content/docs/deploy/ci-pool-projects.md; the
# values below are the first pool project, shown as a worked example.
project_id  = "kube-agents-evals"
gitops_repo = "gke-agentic/kube-agents-evals-infra"

# Defaults match hack/ci-env.sh; override only if that file changes.
# location  = "us-central1"
# namespace = "kubeagents-system"

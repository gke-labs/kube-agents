# Required
project_id   = "my-gcp-project"
cluster_name = "kube-agents"
location     = "us-central1"

# Required: the harness API server key. Generate a strong random value, e.g.
#   openssl rand -hex 32
api_server_key = "REPLACE_WITH_A_STRONG_RANDOM_KEY"

# Model-provider credential(s) — set at least one so the agent can run, unless
# model_provider = "vertex_ai" (see below), which needs none.
# Empty keys are omitted from the Secret.
# NOTE: all keys above and below end up in plaintext in the Terraform state
# (and in the in-cluster Secret) — keep the state in a protected backend.
# anthropic_api_key = "sk-ant-..."
# gemini_api_key    = "..."
# openai_api_key    = "sk-..."

# Image tag for the operator and platform agent. Defaults to "latest";
# pin an X.Y.Z release tag for production.
# image_tag = "1.2.0"

# Pull every image from a mirror instead of the public registries. Copy them
# there first with `make mirror-images MIRROR_PREFIX=<prefix> IMAGE_TAG=<tag>`
# from the repository root, using this same prefix and the same tag as
# image_tag above — the mirror only holds the tag it was told to copy.
# image_registry = "us-east4-docker.pkg.dev/my-project/kube-agents"
# Only if the mirror keeps third-party images (LiteLLM, fluent-bit) elsewhere;
# defaults to image_registry.
# third_party_image_registry = "us-east4-docker.pkg.dev/my-project/mirror"
# Only if that mirror needs authenticating to (Harbor, Artifactory rather than
# an Artifact Registry the nodes can already read). Names Secrets you create
# yourself, in the namespace above, before applying — see the README.
# image_pull_secrets = ["regcred"]

# Cluster topology. "autopilot" (default) or "standard" — standard builds an
# e2-standard-4 node pool with Dataplane V2, and is the only mode
# that can carry the gVisor node pool. Set create_cluster = false to install
# onto an existing cluster (it must already have Workload Identity; CMEK on it
# stays a gcloud step outside Terraform).
# cluster_mode            = "standard"
# create_cluster          = false
# enable_gvisor_node_pool = true
# gvisor_pool_name        = "gvisor-pool"

# Sandboxing on Autopilot, which has the gvisor RuntimeClass built in and no
# node pool to provision. enable_gvisor_node_pool must stay false there.
# agent_runtime_class = "gvisor"

# Cluster tuning
# deletion_protection = true
# release_channel     = "REGULAR"
# namespace           = "kubeagents-system"  # leave as-is: the agent's model
#                                             # gateway endpoint is hard-wired
#                                             # to kubeagents-system
#
# Publish the cluster's DNS-based control plane endpoint to traffic from
# outside the VPC, for a cluster a Platform Agent running elsewhere has to
# reach. Off by default; see the README before turning it on.
# allow_external_dns_traffic = true

# Optional Google Chat backend (Pub/Sub topic + subscription, Chat APIs);
# the CR's googleChat integration is wired to the created topic/subscription
# automatically. Only the Chat-app registration in the console stays manual
# (see the README).
# enable_google_chat        = true
# google_chat_allowed_users = ["you@example.com"]

# Model routing for the bundled LiteLLM gateway (defaults: gemini and the
# provider's default model; set the matching *_api_key above).
# model_provider     = "gemini"
# model_default_name = ""

# Vertex AI / Model Garden instead of an API-key provider — see variables.tf.
# vertex_project_id defaults to the install's project; vertex_location defaults
# to "global" rather than the cluster location, because a model is only callable
# from a location that serves it. Set a region for a data-residency requirement,
# or for a Model Garden partner model served only from specific regions.
# model_provider     = "vertex_ai"
# model_default_name = "gemini-3.5-flash"
# vertex_project_id  = ""
# vertex_location    = ""
# false when vertex_project_id is a project you cannot administer: you enable the
# API and grant the gateway's service account roles/aiplatform.user by hand.
# vertex_manage_serving_project = true


# Optional GitHub integration and token minter backend (GSA + KMS signing key).
# enable_github_minter = true
# github_repo          = "my-github-org/my-repo"

# Optional Slack integration. Needs no GCP resources: the tokens go into the
# credentials Secret and the CR's slack section turns on. Creating the Slack
# app (Socket Mode + bot scopes) stays manual — see the README.
# enable_slack            = true
# slack_bot_token         = "xoxb-..."
# slack_app_token         = "xapp-..."
# slack_allowed_users     = ["U01234567"]
# slack_home_channel      = "C01234567"
# slack_home_channel_name = "#kube-agents"

# Optional AgentPlugins.
# enable_pubsub_platform       = true
# enable_stockout_investigator = true

# IAM. "read-only" (default) selects the bundle the composition grants;
# "custom" requires project_roles. An explicit project_roles list overrides
# permission_set either way. There is no admin bundle -- widening access
# means naming the roles, so that the grant is explicit and reviewed.
# permission_set = "read-only"

# Optional scheduled backups of the release namespace. Off by default in both
# install paths: Backup for GKE bills per backed-up pod and per GB of snapshot
# storage, and the snapshots contain the agent's credentials Secret.
# enable_gke_backup_plan = true
# backup_cron_schedule   = "0 2 * * *"
# backup_retain_days     = 30
# backup_encryption_key  = "projects/my-gcp-project/locations/us-central1/keyRings/my-ring/cryptoKeys/my-key"

# Admission webhooks for the PlatformAgent CR, and the cert-manager install
# that issues their serving certificate. Both default to on.
#
# Set enable_cert_manager = false if the cluster ALREADY runs cert-manager —
# this apply fails on the existing CRDs otherwise. The webhooks keep working
# in that case; they just use the cert-manager that is already there.
#
# Destroying a release that installed cert-manager here removes its CRDs, and
# with them every Certificate and Issuer in the cluster, not only these. On a
# shared cluster, install cert-manager separately and set this to false.
# enable_cert_manager  = true
# enable_webhooks      = true
# cert_manager_version = "v1.21.1"

# Anything the variables above do not reach. Deep-merged over the values this
# composition computes, so one leaf can be set without restating its block.
# extra_helm_values = {
#   litellm = { otel = true }
#   telemetry = { otlpEndpoint = "http://opentelemetry-collector.observability.svc.cluster.local:4318" }
#   platformAgent = { harness = { hermes = { dashboardEnabled = false } } }
# }

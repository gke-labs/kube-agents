# ==============================================================================
# kube-agents install configuration
# ==============================================================================
# Copy this file to install.env beside install.sh and edit it:
#   cp install.env.example install.env
#   chmod 600 install.env
#
# The chmod is not optional. This example is tracked world-readable, so a copy
# of it under a stock umask is 0644 -- and install.env is where the API keys,
# the Slack tokens and API_SERVER_KEY end up. install.sh tightens the mode when
# it loads one and says so, but only from the next run onwards.
#
# install.sh loads it before anything else, and a command-line flag beats it.
# Everything it sets is inherited by later runs, so a re-run that omits a flag
# keeps the value instead of reverting it to a default. That is the point of
# the file: without it, `./install.sh --non-interactive --image-tag=<new>`
# would regenerate the whole configuration from defaults and plan the
# destruction of whatever the omitted flags provisioned.
#
# Precedence, lowest to highest:
#
#     install.defaults.env  ->  an exported environment variable  ->  install.env
#     ->  a command-line flag
#
# This file is sourced with `set -a`, so a key it carries overwrites an exported
# variable of the same name. `PROJECT_ID=other ./install.sh` does not retarget an
# install this file already records -- pass the flag, or edit the key here.
#
# Every commented-out key below shows the default it resolves to. That default
# comes from install.defaults.env, except MODEL_DEFAULT_NAME, which follows
# MODEL_PROVIDER through default_model_for_provider.
# Leave it commented to track that default across releases; uncomment it only to
# pin a value of your own. A default copied in here stops following the project.
#
# This is an INPUT. install.sh never writes here. It derives
# terraform/examples/full-install/terraform.tfvars from it, and that file is
# regenerated on every run — do not edit it.
#
# Values are read with `set -a; . install.env; set +a`, so this is shell syntax:
# one NAME=value per line, and quote anything containing spaces. Do not add
# `export` (it is harmless, but unnecessary).
#
# The file holds credentials. install.sh creates it mode 600 if it creates it at
# all, .gitignore excludes it, and it should stay out of any image or archive.
# To keep credentials out of files entirely, set PERSIST_SECRETS_ON_DISK=false
# and pass them as environment variables; the installer recovers them from the
# live platform-agent-secrets Secret on later runs.
#
# Alternative location: point KUBE_AGENTS_INSTALL_ENV at any path. That is how
# CI renders one from its own variables rather than keeping state on a runner.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Where the install goes  (required)
# ------------------------------------------------------------------------------
PROJECT_ID=your-gcp-project-id
CLUSTER_NAME=platform-agent-host
REGION=us-central1

# Shape of a cluster this run CREATES: autopilot | standard. Ignored against a
# cluster that already exists — the installer probes its live shape and that
# wins, so a stale value here can never plan a running cluster's replacement.
# Autopilot clusters are regional; a zonal REGION needs standard.
# CLUSTER_MODE=autopilot

# The Kubernetes namespace the agent and operator are installed into. Almost
# nothing needs to change it; it is here because CI renders this file from a
# GitHub environment that may name a different one.
# NAMESPACE=kubeagents-system

# PROJECT_NUMBER and KMS_LOCATION are deliberately absent. Both are derived
# every run — from `gcloud projects describe` and from REGION — so a copy here
# would be a second answer that can disagree with the first.

# ------------------------------------------------------------------------------
# 2. Model provider
# ------------------------------------------------------------------------------
# gemini | vertex_ai | anthropic | openai
MODEL_PROVIDER=gemini
# MODEL_DEFAULT_NAME=gemini-3.5-flash

# Vertex AI only. It authenticates with Workload Identity and needs no API key.
# VERTEX_LOCATION=global gives no in-region ML processing guarantee; name a
# region if you have a data-residency requirement.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=global
# Set false when VERTEX_PROJECT_ID is a project you cannot administer: the
# install then skips enabling aiplatform.googleapis.com there and granting the
# gateway's service account roles/aiplatform.user on it, and you make that
# grant by hand. The service account itself is still created in PROJECT_ID.
# VERTEX_MANAGE_SERVING_PROJECT=true

# Credentials for the provider you chose. Leave the others empty.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Chat integrations
# ------------------------------------------------------------------------------
# GOOGLE_CHAT_ENABLED=false
# CHAT_TOPIC_NAME=platform-agent-chat-events
# CHAT_SUB_NAME=platform-agent-chat-events-sub
# GOOGLE_CHAT_MODE=default

# Comma-separated emails allowed to talk to the agent over Google Chat.
# An EMPTY list allows every user, so an install that means to restrict access
# must set this. --allowed-users is the flag equivalent.
# ALLOWED_USERS=

# SLACK_ENABLED=false
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=
# SLACK_HOME_CHANNEL=
# SLACK_HOME_CHANNEL_NAME=

# ------------------------------------------------------------------------------
# 4. GitOps repository and the GitHub App token minter
# ------------------------------------------------------------------------------
# The repository the agent opens pull requests against. It must be owned by an
# ORGANIZATION: the minter resolves App installations at /orgs/{org}/installation,
# which does not exist for a personal account. A free organization is enough.
#
# GITOPS_, not GITHUB_. GH_ORG/GH_REPO name the *release* repository elsewhere in
# this project, and tests/e2e/.env uses GITHUB_ORG/GITHUB_REPO for the repository
# a test acts on — three different repositories that were sharing two names.
# GITHUB_ORG/GITHUB_REPO still work here for one release, with a warning.
# GITOPS_ORG=
# GITOPS_REPO=gke-fleet-iac
# GITHUB_APP_ID=
# KMS_KEYRING=github-token-minter-keyring
# KMS_KEY=github-token-minter-key
# Path to the App's downloaded private key. Imported into KMS once, then unused.
# GITHUB_PEM_PATH=

# ------------------------------------------------------------------------------
# 5. Agent permissions, isolation, and features
# ------------------------------------------------------------------------------
# read-only | custom. Kubernetes RBAC is read-only in both; this is the GCP IAM
# bundle for the agent's service account.
# PLATFORM_AGENT_PERMISSION_SET=read-only
# Required, and only read, when the permission set is custom.
# PLATFORM_AGENT_CUSTOM_ROLES=

# GKE Sandbox. On Standard this provisions a gVisor node pool; on Autopilot it
# uses the built-in RuntimeClass.
# ENABLE_GVISOR=true

# file | hindsight | off. `file` keeps per-user Markdown inside the pod and adds
# no services, but is loaded into the model's context whole. `hindsight` deploys
# a searchable store (API + Postgres) into the cluster.
# MEMORY=file
# USER_PROFILE_ENABLED=false

# The Hermes dashboard on port 9119. Off by default for attack surface.
# HERMES_DASHBOARD_ENABLED=false

# ENABLE_GKE_BACKUP_PLAN=false

# ------------------------------------------------------------------------------
# 6. Container registries
# ------------------------------------------------------------------------------
# Where the images this project builds are pulled from. The default is the
# public registry; set this to a mirror for a behind-the-firewall install.
# REGISTRY_PREFIX=ghcr.io/gke-labs/kube-agents
# Where the mirrored third-party images (LiteLLM, fluent-bit, the token minter,
# Hindsight) are pulled from. Empty leaves them on their upstream registries.
# Widening REGISTRY_PREFIX to cover them is what this exists to avoid.
# See `make mirror-images`.
# THIRD_PARTY_REGISTRY_PREFIX=

# ------------------------------------------------------------------------------
# 7. Secrets handling
# ------------------------------------------------------------------------------
# false keeps every credential out of the files the installer writes; they
# travel to Terraform as TF_VAR_* instead and are recovered from the live
# platform-agent-secrets Secret on later runs.
# PERSIST_SECRETS_ON_DISK=true

# The gateway's API key. Generated once when absent — from the live Secret if
# there is one, otherwise fresh — and then left alone.
#
# To ROTATE it, put a new value here. Clearing this line does not rotate:
# against an existing install the run recovers the key straight back out of the
# live platform-agent-secrets Secret, so it re-imports the very key you cleared
# and reports nothing unusual. A non-empty value skips that recovery and is
# what reaches the cluster.
# API_SERVER_KEY=

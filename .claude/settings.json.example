{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/live_test_lease.py\" hook-pretooluse",
            "timeout": 50
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/live_test_lease.py\" hook-sessionend",
            "timeout": 45
          }
        ]
      }
    ]
  }
}

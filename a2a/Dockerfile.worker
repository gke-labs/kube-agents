# a2a-worker: the session-pod image - the harness's native binary plus the
# worker adapter as the entry point.
#
# PLAYGROUND POSTURE: this image authenticates to the bus with a static
# per-component NATS user and reaches the model through the install's
# LiteLLM with no per-worker credential. Each of these has a decided design
# in the specs (auth callout, Vertex/WI per profile); none of them gates
# "Adam can play." Static creds are the playground, not the product. The
# temporary cluster view (A2A_SESSION_CLUSTER_VIEW) is the other playground
# posture here: it is a stopgap, not the product.

# Build from the REPOSITORY root (the shim client and the cluster agent's
# skills below live outside a2a/):
#   docker build -f a2a/Dockerfile.worker -t <registry>/a2a-worker:<tag> .

# Bases come from images.json, the repo's image inventory, spelled the way
# a2a/Dockerfile.gateway spells them so `make mirror-images` and the pinning
# there cover this build too, and the published image is the inventory's
# a2a-worker entry; a mirrored or air-gapped build has to be able to resolve
# the bases like any other.
ARG GOLANG_IMAGE=golang
ARG GOLANG_VERSION=1.27-alpine
ARG NODE_IMAGE=node
ARG NODE_VERSION=24-slim

# --- adapter build stage ---
FROM ${GOLANG_IMAGE}:${GOLANG_VERSION} AS build
# Refuse to download a toolchain the pin above does not name: without this, a
# substituted GOLANG_IMAGE older than a2a/go.mod's `go` directive silently
# fetches a newer one instead of failing the build (#1138).
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY a2a/go.mod a2a/go.sum ./
RUN go mod download
COPY a2a/ .
RUN CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-w -s" -o /out/worker-adapter ./cmd/worker-adapter
# The session agent's Claude Code home: the persona as CLAUDE.md and the
# cluster agent's read-only skills as skills/<name>/SKILL.md, adapted for a
# session by cmd/session-persona. agents/cluster/skills stays the one source
# of the skills; the build fails if one of them stops parsing as a skill.
COPY agents/cluster/skills/ /skills/
RUN go run ./cmd/session-persona -skills /skills -persona persona/session/persona.md -out /out/claude

# --- runtime ---
FROM ${NODE_IMAGE}:${NODE_VERSION}

WORKDIR /app
# The agent SDK's platform package carries the harness as a native binary at
# node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude, the path
# DefaultHarnessPath in worker-adapter/harness.go names. Pinned to the
# version these stream-json shapes were proved against.
RUN npm install @anthropic-ai/claude-agent-sdk@0.3.236 \
    && npm cache clean --force

# The temporary cluster view (operator flag A2A_SESSION_CLUSTER_VIEW): stock
# kubectl at /usr/local/libexec/kubectl with a /usr/local/bin/kubectl wrapper
# that routes through <agent>-kube-proxy when KUBE_PROXY_URL is set, and gcloud
# on PATH as the credential broker's shim, which forwards an argv to the broker
# and prints its refusal as `policy rule: <rule>`. The shim is Python, so
# python3 is installed, with python3-yaml beside it: the shim parses the
# kubeconfig `gcloud container clusters get-credentials` returns, and any
# kubeconfig a `kubectl --kubeconfig=` or KUBECONFIG names, and without PyYAML
# those crash after the broker has already run the command. jq is installed
# too, because the cluster agent's persona requires it (requires.commands in
# agents/cluster/persona/persona.yaml): its skills filter gcloud and kubectl
# JSON with it. It holds no credential. git is installed for the persona's
# version-control skill, credential-free and local-only (the layer after the
# shim says how). No native gcloud or gh exist in this image, and the guard
# below keeps it so. With the flag off the pod has no KUBE_PROXY_URL or
# CREDENTIAL_PROXY_URL. gh and git are deliberately not linked to the shim: the
# broker's session role refuses them anyway, and the forge is reached through
# the version-control verbs. The forwarder itself lives under libexec, off
# PATH, so the only shim on PATH is gcloud.
ARG KUBECTL_VERSION=1.35.10
ARG KUBECTL_SHA256_AMD64=c49a28f1f4efc4d475ed05f47f2ce8e563bf7bef69ed77fe1b924ea6d83b6327
ARG KUBECTL_SHA256_ARM64=283f1be6a46b3695b625e25030106b8ffe18bd0d3a900f5b65c259ca407f04f5
COPY deploy/sandbox/check_kubectl_base_path.py /tmp/check_kubectl_base_path.py
COPY deploy/sandbox/kubectl_session_fastpath.py /tmp/kubectl_session_fastpath.py
# The wrapper below asks this first, and starts Python only when the context is not registered yet.
COPY --chmod=0755 deploy/sandbox/kubectl_context_registered.sh /usr/local/libexec/kubectl-context-registered
# The sandbox shell's kubectl admission, at the sandbox's paths, so a cluster-wide read that
# cannot fit in the pod's memory limit is refused with the alternatives rather than OOM-killing
# the session pod. The wrapper's KUBE_PROXY_URL branch below runs it with three settings of
# deploy/sandbox/kubectl-admit.py: its state in a directory the node user owns, the guard as a
# library (nothing starts it as a daemon here; the worker adapter is PID 1), and a command that
# finds the pod busy run as before, never refused, so its only refusal is a read larger than
# the pod can ever hold. No limit file is written, so the limit is the cgroup's memory.max.
COPY --chmod=0644 deploy/sandbox/kubectl-admit.py /usr/local/libexec/kubectl-admit
COPY --chmod=0644 deploy/sandbox/shell-memory-guard.py /usr/local/libexec/shell-memory-guard
COPY --chmod=0644 deploy/sandbox/kubectl-costs.json /usr/local/share/kube-agents/kubectl-costs.json
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-yaml jq git \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c 'import yaml' \
    && jq --version \
    && ARCH=$(dpkg --print-architecture) \
    && case "${ARCH}" in \
         amd64) KUBECTL_SHA256="${KUBECTL_SHA256_AMD64}" ;; \
         arm64) KUBECTL_SHA256="${KUBECTL_SHA256_ARM64}" ;; \
         *) echo "no kubectl checksum pinned for ${ARCH}" >&2; exit 1 ;; \
       esac \
    && install -d -m 0755 /usr/local/libexec \
    && curl -sSLf --retry 5 --retry-all-errors -o /usr/local/libexec/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" \
    && echo "${KUBECTL_SHA256}  /usr/local/libexec/kubectl" | sha256sum -c - \
    && chmod 0755 /usr/local/libexec/kubectl \
    && python3 -I /tmp/check_kubectl_base_path.py /usr/local/libexec/kubectl \
    && rm /tmp/check_kubectl_base_path.py
# Per cost tier, the smallest memory limit at which the admission above can refuse nothing
# (deploy/sandbox/kubectl_session_fastpath.py); the wrapper runs kubectl directly for every
# command on a pod at or above its tier's figure.
RUN python3 -I -B /tmp/kubectl_session_fastpath.py /usr/local/libexec/kubectl-admit \
      /usr/local/libexec/shell-memory-guard /usr/local/share/kube-agents/kubectl-costs.json \
      >/usr/local/share/kube-agents/kubectl-session-fastpath \
    && chmod 0644 /usr/local/share/kube-agents/kubectl-session-fastpath \
    && test -s /usr/local/share/kube-agents/kubectl-session-fastpath \
    && rm /tmp/kubectl_session_fastpath.py
# The kubectl wrapper: deploy/sandbox/session-kubectl.sh says what it does on
# each kind of pod.
COPY --chmod=0755 deploy/sandbox/session-kubectl.sh /usr/local/bin/kubectl
# credential-proxy-exec is a launcher that imports the client as a module, so
# Python loads the client from bytecode compiled here and does not compile its
# source at every brokered call (deploy/sandbox/Dockerfile says more).
COPY --chmod=0755 deploy/shared/credential-proxy-exec.py /opt/credential-proxy/libexec/credential-proxy-exec
COPY --chmod=0644 agents/platform/scripts/credential_proxy_client.py /opt/credential-proxy/libexec/credential_proxy_client.py
RUN python3 -m compileall -q --invalidation-mode unchecked-hash /opt/credential-proxy/libexec/credential_proxy_client.py \
    && python3 -v /opt/credential-proxy/libexec/credential-proxy-exec --help 2>&1 \
       | grep "code object from '/opt/credential-proxy/libexec/__pycache__/credential_proxy_client\.cpython-[0-9]*\.pyc'" >/dev/null
# The version-control skill a profile persona carries (its scripts/vcs.py, a
# copy of agents/platform/skills/version-control/scripts/vcs.py) imports
# vcs_client from here, beside the broker client: vcs.py appends this directory
# to its path. These three are vcs_client's whole import closure besides
# credential_proxy_client, and the import below fails the build if that stops
# being true. Root-owned and read-only to the node user, like the client.
COPY --chmod=0644 agents/platform/scripts/vcs_client.py \
     agents/platform/scripts/gitops_workspace.py \
     agents/platform/scripts/repo_ref.py \
     /opt/credential-proxy/libexec/
# The fleet-audit report scripts, for the fleet-audit AgentProfile's persona
# (agents/fleet-audit/persona, #5623): copied from their sources at build time,
# flat in one directory, since a script's own directory is where Python finds
# the others when the persona's skill runs `python3 /opt/kube-agents/scripts/fleet-audit/
# audit_report.py`. They're the closure audit_report.py imports on its
# `finish --dry-run` path (a live finish needs more, which the PR that runs one
# adds), and, from collect.py on, the compliance collector's (below); the RUN
# below fails the build if one no longer imports from here alone,
# and tests/test_worker_fleet_audit_scripts.py runs that finish on a document.
# Every worker carries them; they act only with the task's own confined
# credential, so a cluster or tse worker gains nothing it couldn't already do.
# They're under lib.ScriptRoot (/opt/kube-agents/scripts/), the one root a
# script row may name, root-owned and not worker-writable as script mode
# requires. tests/test_worker_fleet_audit_scripts.py holds this list to its
# sources, and the directory to that root.
COPY --chmod=0644 agents/platform/skills/fleet-audit/scripts/audit_report.py \
     agents/platform/skills/fleet-audit/scripts/report_status.py \
     agents/platform/skills/fleet-audit/scripts/manifest_delta.py \
     agents/platform/scripts/gitops_workspace.py \
     agents/platform/scripts/repo_ref.py \
     agents/platform/scripts/gitops_preflight.py \
     agents/platform/scripts/credential_proxy_client.py \
     agents/platform/scripts/vcs_client.py \
     agents/platform/skills/fleet-audit/scripts/collect.py \
     agents/platform/skills/fleet-audit/scripts/kcc_health.py \
     agents/platform/scripts/fleet_scope_args.py \
     agents/platform/scripts/collector_run.py \
     agents/platform/scripts/broker_admission.py \
     /opt/kube-agents/scripts/fleet-audit/
# The compliance audit's collector (collect.py and its closure, #5623): each
# fan-out child runs it for its one cluster (--project with --cluster),
# read-only, on its confined
# credential, so the canary is collected the way the platform job collects.
# Its webhook check imports the fleet-upgrade-verification readiness modules
# from parents[2]/fleet-upgrade-verification/scripts, relative to collect.py,
# so they go there as in the skill's own layout. Same tests and drift check.
COPY --chmod=0644 agents/platform/skills/fleet-upgrade-verification/scripts/upgrade_readiness.py \
     agents/platform/skills/fleet-upgrade-verification/scripts/upgrade_shape_tables.py \
     agents/platform/skills/fleet-upgrade-verification/scripts/known_issues.json \
     agents/platform/skills/fleet-upgrade-verification/scripts/removed_apis.json \
     /opt/kube-agents/fleet-upgrade-verification/scripts/
# A directory copy takes no --chmod (it would set the directories' mode too,
# and a 0644 directory can't be entered); the RUN makes it readable by all
# and enterable (directories 0755), writable by root alone, and the last check imports it as the worker's own user.
COPY agents/platform/skills/fleet-upgrade-verification/scripts/readiness_rules/ \
     /opt/kube-agents/fleet-upgrade-verification/scripts/readiness_rules/
# Its own RUN: a mode change beside a path under the helper script root is one
# deploy/docker/test_script_root_ownership.py can't vouch for.
RUN chmod -R u=rwX,go=rX /opt/kube-agents/fleet-upgrade-verification
RUN cd /opt/kube-agents/scripts/fleet-audit \
    && PYTHONDONTWRITEBYTECODE=1 python3 -c "import sys; sys.path[:0] = ['.']; import report_status, manifest_delta, gitops_workspace, repo_ref, gitops_preflight, credential_proxy_client, vcs_client, audit_report, collect; assert collect._upgrade_readiness() is not None" \
    && PYTHONDONTWRITEBYTECODE=1 python3 audit_report.py finish --help | grep -q -- --dry-run \
    && PYTHONDONTWRITEBYTECODE=1 python3 collect.py --help | grep -q -- compliance-audit \
    && su node -s /bin/sh -c 'cd /opt/kube-agents/scripts/fleet-audit && PYTHONDONTWRITEBYTECODE=1 python3 -c "import sys; sys.path[:0] = [\".\"]; import collect; assert collect._upgrade_readiness() is not None"'
# git for that skill's local half: the working copy `clone` unpacks from a
# bundle, and `commit` and `publish` on it. It holds no credential; the profile
# namespace's NetworkPolicy bounds the pod's egress. deploy/shared/worker-gitconfig,
# the system config, sets no credential helper, refuses every transport but
# `file`, opens a bare repository only when named, and runs no hooks. That is a
# default the model can override, so git's curl-based helpers (the HTTP remote
# helpers, http-fetch, http-push and imap-send) are deleted too, as in the
# sandbox image (deploy/sandbox/Dockerfile says why deletion and not config is
# what holds there), and no ssh client is installed. With the config overridden,
# git:// and ext:: still work: those are git's own code, and egress is the
# NetworkPolicy's to bound. The probes match git's
# message rather than its exit status, since example.invalid fails to resolve
# whatever the image holds: refused by the config, then, with the config
# overridden, no helper to run. The last probe is the file transport working,
# so a git broken outright doesn't pass for a git disarmed.
COPY --chmod=0644 deploy/shared/worker-gitconfig /etc/gitconfig
RUN rm -f /usr/lib/git-core/git-remote-http /usr/lib/git-core/git-remote-https \
          /usr/lib/git-core/git-remote-ftp /usr/lib/git-core/git-remote-ftps \
          /usr/lib/git-core/git-http-fetch /usr/lib/git-core/git-http-push \
          /usr/lib/git-core/git-imap-send \
    && for program in git-http-fetch git-http-push git-imap-send; do \
         if [ -e "/usr/lib/git-core/${program}" ]; then \
           echo "worker git still has a curl-based program: ${program}" >&2; exit 1; \
         fi; \
       done \
    && for helper in http https ftp ftps; do \
         if [ -e "/usr/lib/git-core/git-remote-${helper}" ]; then \
           echo "worker git still has a remote transport: ${helper}" >&2; exit 1; \
         fi; \
         git ls-remote "${helper}://example.invalid/x.git" 2>&1 \
           | grep -q "transport '${helper}' not allowed" \
           || { echo "worker git does not refuse ${helper}:// by config" >&2; exit 1; }; \
         git -c "protocol.${helper}.allow=always" ls-remote "${helper}://example.invalid/x.git" 2>&1 \
           | grep -qE "'remote-${helper}' is not a git command|Unable to find remote helper" \
           || { echo "worker git still resolves a ${helper} transport" >&2; exit 1; }; \
       done \
    && for client in ssh scp sftp; do \
         if command -v "${client}" >/dev/null 2>&1; then \
           echo "worker image has an ssh client: ${client}" >&2; exit 1; \
         fi; \
       done \
    && git ls-remote ssh://example.invalid/x 2>&1 | grep -q "transport 'ssh' not allowed" \
    && test -z "$(git config --system --get-all credential.helper)" \
    && test "$(git config --system --get safe.bareRepository)" = explicit \
    && test "$(git config --system --get core.hooksPath)" = /dev/null \
    && git init -q /tmp/vcs-guard \
    && git -C /tmp/vcs-guard -c user.name=g -c user.email=g@x commit -q --allow-empty -m g \
    && git -C /tmp/vcs-guard bundle create /tmp/vcs-guard.bundle --all \
    && git clone -q /tmp/vcs-guard.bundle /tmp/vcs-guard-clone \
    && rm -rf /tmp/vcs-guard /tmp/vcs-guard.bundle /tmp/vcs-guard-clone \
    && PYTHONDONTWRITEBYTECODE=1 python3 -I -c "import sys; sys.path.append('/opt/credential-proxy/libexec'); import vcs_client, gitops_workspace, repo_ref"
RUN mkdir -p /opt/credential-proxy/bin \
    && for binary in gcloud; do \
         ln -s /opt/credential-proxy/libexec/credential-proxy-exec "/opt/credential-proxy/bin/${binary}"; \
       done \
    && for binary in gcloud gh; do \
         if command -v "${binary}" >/dev/null 2>&1; then \
           echo "unexpected credential-aware CLI in the worker image: ${binary}" >&2; exit 1; \
         fi; \
       done
ENV PATH="/opt/credential-proxy/bin:${PATH}"

COPY --from=build /out/worker-adapter /usr/local/bin/worker-adapter

# Non-root as the stock node user (UID 1000, matching the spawner's
# runAsUser); the harness keeps its state under a writable HOME.
RUN mkdir -p /home/node/.claude /scratch \
    && chown -R node:node /home/node /app /scratch
# The persona and skills land where Claude Code reads user memory and user
# skills: CLAUDE_CONFIG_DIR below, which nothing in the session pod's spec
# mounts over. Copied after the chown so they stay root-owned: the harness
# reads them and cannot edit one in place. It does own /home/node/.claude, so
# it could move skills/ aside and write its own; this keeps the shipped text
# from being changed by accident, and is not a boundary against the harness.
COPY --from=build /out/claude/CLAUDE.md /home/node/.claude/CLAUDE.md
COPY --from=build /out/claude/skills/ /home/node/.claude/skills/
# The build-time content manifest of the two above; the worker checks them
# against it at start (worker-adapter CheckSessionHome).
COPY --from=build /out/claude/skills_manifest.sha256 /home/node/.claude/skills_manifest.sha256
USER node
# vcs_client's git and working copies: the image's git, and the worker's
# scratch volume, which the worker empties after every task (the root
# filesystem is read-only on a profile worker).
ENV HOME=/home/node \
    CLAUDE_CONFIG_DIR=/home/node/.claude \
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
    KUBE_AGENTS_LOCAL_GIT=/usr/bin/git \
    KUBE_AGENTS_VCS_ROOT=/scratch/vcs

ENTRYPOINT ["/usr/local/bin/worker-adapter"]

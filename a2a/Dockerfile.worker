# a2a-worker: the session-pod image - the harness's native binary plus the
# worker adapter as the entry point.
#
# PLAYGROUND POSTURE: this image authenticates to the bus with a static
# per-component NATS user and reaches the model through the install's
# LiteLLM with no per-worker credential. Each of these has a decided design
# in the specs (auth callout, Vertex/WI per profile); none of them gates
# "Adam can play." Static creds are the playground, not the product. The
# temporary cluster view (A2A_SESSION_CLUSTER_VIEW) is the other playground
# posture here: it is a stopgap, not the product.

# Build from the REPOSITORY root (the shim client and the cluster agent's
# skills below live outside a2a/):
#   docker build -f a2a/Dockerfile.worker -t <registry>/a2a-worker:<tag> .

# Bases come from images.json, the repo's image inventory, spelled the way
# a2a/Dockerfile.gateway spells them so `make mirror-images` and the pinning
# there cover this build too, and the published image is the inventory's
# a2a-worker entry; a mirrored or air-gapped build has to be able to resolve
# the bases like any other.
ARG GOLANG_IMAGE=golang
ARG GOLANG_VERSION=1.27-alpine
ARG NODE_IMAGE=node
ARG NODE_VERSION=22-slim

# --- adapter build stage ---
FROM ${GOLANG_IMAGE}:${GOLANG_VERSION} AS build
# Refuse to download a toolchain the pin above does not name: without this, a
# substituted GOLANG_IMAGE older than a2a/go.mod's `go` directive silently
# fetches a newer one instead of failing the build (#1138).
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY a2a/go.mod a2a/go.sum ./
RUN go mod download
COPY a2a/ .
RUN CGO_ENABLED=0 GOOS=linux \
    go build -trimpath -ldflags="-w -s" -o /out/worker-adapter ./cmd/worker-adapter
# The session agent's Claude Code home: the persona as CLAUDE.md and the
# cluster agent's read-only skills as skills/<name>/SKILL.md, adapted for a
# session by cmd/session-persona. agents/cluster/skills stays the one source
# of the skills; the build fails if one of them stops parsing as a skill.
COPY agents/cluster/skills/ /skills/
RUN go run ./cmd/session-persona -skills /skills -persona persona/session/persona.md -out /out/claude

# --- runtime ---
FROM ${NODE_IMAGE}:${NODE_VERSION}

WORKDIR /app
# The agent SDK's platform package carries the harness as a native binary at
# node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude, the path
# DefaultHarnessPath in worker-adapter/harness.go names. Pinned to the
# version these stream-json shapes were proved against.
RUN npm install @anthropic-ai/claude-agent-sdk@0.3.236 \
    && npm cache clean --force

# The temporary cluster view (operator flag A2A_SESSION_CLUSTER_VIEW): stock
# kubectl at /usr/local/libexec/kubectl with a /usr/local/bin/kubectl wrapper
# that routes through <agent>-kube-proxy when KUBE_PROXY_URL is set, and gcloud
# on PATH as the credential broker's shim, which forwards an argv to the broker
# and prints its refusal as `policy rule: <rule>`. The shim is Python, so
# python3 is installed, with python3-yaml beside it: the shim parses the
# kubeconfig `gcloud container clusters get-credentials` returns, and any
# kubeconfig a `kubectl --kubeconfig=` or KUBECONFIG names, and without PyYAML
# those crash after the broker has already run the command. jq is installed
# too, because the cluster agent's persona requires it (requires.commands in
# agents/cluster/persona/persona.yaml): its skills filter gcloud and kubectl
# JSON with it. It holds no credential. No native gcloud, gh or git exist in
# this image, and the guard below keeps it so. With the flag off the pod has no
# KUBE_PROXY_URL or CREDENTIAL_PROXY_URL. gh and git are deliberately not
# linked: the broker's session role refuses them anyway, and a name that is not
# on PATH is a clearer answer. The forwarder itself lives under libexec, off
# PATH, so the only shim on PATH is gcloud.
ARG KUBECTL_VERSION=1.35.10
ARG KUBECTL_SHA256_AMD64=c49a28f1f4efc4d475ed05f47f2ce8e563bf7bef69ed77fe1b924ea6d83b6327
ARG KUBECTL_SHA256_ARM64=283f1be6a46b3695b625e25030106b8ffe18bd0d3a900f5b65c259ca407f04f5
COPY deploy/sandbox/check_kubectl_base_path.py /tmp/check_kubectl_base_path.py
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-yaml jq \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c 'import yaml' \
    && jq --version \
    && ARCH=$(dpkg --print-architecture) \
    && case "${ARCH}" in \
         amd64) KUBECTL_SHA256="${KUBECTL_SHA256_AMD64}" ;; \
         arm64) KUBECTL_SHA256="${KUBECTL_SHA256_ARM64}" ;; \
         *) echo "no kubectl checksum pinned for ${ARCH}" >&2; exit 1 ;; \
       esac \
    && install -d -m 0755 /usr/local/libexec \
    && curl -sSLf --retry 5 --retry-all-errors -o /usr/local/libexec/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" \
    && echo "${KUBECTL_SHA256}  /usr/local/libexec/kubectl" | sha256sum -c - \
    && chmod 0755 /usr/local/libexec/kubectl \
    && python3 -I /tmp/check_kubectl_base_path.py /usr/local/libexec/kubectl \
    && rm /tmp/check_kubectl_base_path.py \
    && printf '%s\n' \
         '#!/bin/sh' \
         'if [ -n "${KUBE_PROXY_URL:-}" ]; then' \
         '  case " $* " in' \
         '  *" --context"*)' \
         '    PYTHONDONTWRITEBYTECODE=1 python3 -I /opt/credential-proxy/libexec/credential-proxy-exec --ensure-kubectl-context "$@" 2>/dev/null || true' \
         '    ;;' \
         '  *)' \
         '    if [ ! -f "${HOME}/.kube/config" ]; then' \
         '      PYTHONDONTWRITEBYTECODE=1 python3 -I /opt/credential-proxy/libexec/credential-proxy-exec --ensure-kubectl-context "$@" 2>/dev/null || true' \
         '    fi' \
         '    ;;' \
         '  esac' \
         'fi' \
         'exec /usr/local/libexec/kubectl "$@"' \
         >/usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl
COPY --chmod=0755 agents/platform/scripts/credential_proxy_client.py /opt/credential-proxy/libexec/credential-proxy-exec
RUN mkdir -p /opt/credential-proxy/bin \
    && for binary in gcloud; do \
         ln -s /opt/credential-proxy/libexec/credential-proxy-exec "/opt/credential-proxy/bin/${binary}"; \
       done \
    && for binary in gcloud gh git; do \
         if command -v "${binary}" >/dev/null 2>&1; then \
           echo "unexpected credential-aware CLI in the worker image: ${binary}" >&2; exit 1; \
         fi; \
       done
ENV PATH="/opt/credential-proxy/bin:${PATH}"

COPY --from=build /out/worker-adapter /usr/local/bin/worker-adapter

# Non-root as the stock node user (UID 1000, matching the spawner's
# runAsUser); the harness keeps its state under a writable HOME.
RUN mkdir -p /home/node/.claude /scratch \
    && chown -R node:node /home/node /app /scratch
# The persona and skills land where Claude Code reads user memory and user
# skills: CLAUDE_CONFIG_DIR below, which nothing in the session pod's spec
# mounts over. Copied after the chown so they stay root-owned: the harness
# reads them and cannot edit one in place. It does own /home/node/.claude, so
# it could move skills/ aside and write its own; this keeps the shipped text
# from being changed by accident, and is not a boundary against the harness.
COPY --from=build /out/claude/CLAUDE.md /home/node/.claude/CLAUDE.md
COPY --from=build /out/claude/skills/ /home/node/.claude/skills/
USER node
ENV HOME=/home/node \
    CLAUDE_CONFIG_DIR=/home/node/.claude \
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

ENTRYPOINT ["/usr/local/bin/worker-adapter"]

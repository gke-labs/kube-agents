    "$JS.API.CONSUMER.MSG.NEXT.PROFILE_SUBMITS.profile-alpha-read-child",
    "$JS.ACK.PROFILE_SUBMITS.profile-alpha-read-child.>",
    "$JS.API.CONSUMER.INFO.PROFILE_SUBMITS.profile-alpha-unattended-top",
    "$JS.API.CONSUMER.MSG.NEXT.PROFILE_SUBMITS.profile-alpha-unattended-top",
    "$JS.ACK.PROFILE_SUBMITS.profile-alpha-unattended-top.>",
    "$JS.API.CONSUMER.INFO.PROFILE_SUBMITS.profile-alpha-unattended-child",
    "$JS.API.CONSUMER.MSG.NEXT.PROFILE_SUBMITS.profile-alpha-unattended-child",

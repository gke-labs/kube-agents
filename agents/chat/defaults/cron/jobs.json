      "schedule": {
        "kind": "cron",
        "expr": "* * * * *",
        "display": "* * * * *"
      },
      "prompt": "",
      "no_agent": true,
      "script": "bootstrap_delivery.py",
      "risk": "low",
      "enabled": true,

   "apiVersion": "apps/v1",
   "kind": "Deployment",
   "metadata": {
    "name": "inference-server",
    "namespace": "seeded-capacity"
   },
   "spec": {
    "replicas": 4,
    "selector": {
     "matchLabels": {
      "app": "inference-server"
     }
    },
    "template": {
     "metadata": {
      "labels": {
       "app": "inference-server"
      }
     },
     "spec": {
      "containers": [
       {
        "command": [
         "sh",
         "-c",
         "while true; do :; done"
        ],
        "image": "busybox:1.36",
        "name": "server",
        "resources": {
         "limits": {
          "cpu": "500m",
          "memory": "128Mi"
         },
         "requests": {
          "cpu": "400m",
          "memory": "64Mi"

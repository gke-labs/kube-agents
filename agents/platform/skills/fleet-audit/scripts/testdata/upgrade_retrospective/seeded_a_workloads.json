        }
       }
      ],
      "nodeSelector": {
       "seeded-role": "pinned-inference"
      },
      "restartPolicy": "Always",
      "shareProcessNamespace": false,
      "topologySpreadConstraints": [
       {
        "labelSelector": {
         "matchLabels": {
          "app": "inference-server"
         }
        },
        "maxSkew": 1,
        "topologyKey": "kubernetes.io/hostname",
        "whenUnsatisfiable": "ScheduleAnyway"
       }
      ],
      "volumes": []
     }

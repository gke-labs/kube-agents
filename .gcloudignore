# Version control
.git
.github

# IDEs and AI agent logs/scratch files
.idea/
.vscode/
.gemini/
# Claude Code keeps session transcripts and git worktrees here. The worktrees
# are full repository checkouts, so an unignored .claude/ turns a ~240M upload
# into a ~930M one -- and the worktrees carry their own .git, which the
# `.git` line above does not match at that depth.
.claude/
.DS_Store
Thumbs.db

# Build and package caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
node_modules/
.venv/
venv/
k8s-operator/bin/
# `terraform init` writes provider plugins to `.terraform/`, about 436M on a tree
# that has run the installer, and an apply writes state files that can hold
# secrets. `.gitignore` covers them, but gcloud reads `.gitignore` only when no
# `.gcloudignore` exists, so repeat them here.
.terraform/
*.tfstate
*.tfstate.*
# An install also writes its variables (`terraform.tfvars`, through a `.tmp`
# file that an interrupted run can leave) and override files, which name the
# project, the cluster and the state bucket and can hold secrets.
*.tfvars
!*.tfvars.example
*.tfvars.json
*.tfvars.tmp
*_override.tf
*_override.tf.json
override.tf
override.tf.json

# Local configuration files (except tracked default .env)
.env
.env.*
!agents/shared/defaults/.env
**/vars.sh
# The hand-authored install configuration. It holds credentials, and the
# patterns above do not reach it: they anchor on a leading dot.
install.env
**/install.env

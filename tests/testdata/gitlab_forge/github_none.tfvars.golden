# Generated by the kube-agents installer from install.env — regenerated on every
# run. Change settings through install.sh (or its --menu) rather than here.
project_id   = "test-project"
cluster_name = "test-cluster"
location     = "us-central1"
namespace    = "kubeagents-system"

# One fixed name per project each, while this state is per cluster: a
# second install in the project names its own in install.env.
agent_service_account_id         = "kubeagents-platform-gsa"
github_minter_service_account_id = "kubeagents-github-minter-gsa"
litellm_service_account_id       = "kubeagents-litellm-gsa"

# GKE database encryption. install.sh's existing-cluster step reads the
# same two keys, so a create and an adoption encrypt with one key.
kms_keyring_name = "platform-agent-keyring"
kms_key_name     = "k8s-secret-encryption-key"

# The DNS endpoint is open and deletion protection is off. cluster_mode is
# the live cluster's own shape whenever there is one to probe, and the
# --gke-cluster-mode the install asked for only on a create.
cluster_mode               = "autopilot"
create_cluster             = false
# An adoption that chose to install without NetworkPolicy enforcement.
# Inert on a created cluster and on one that already enforces.
accept_no_network_policy   = false
allow_external_dns_traffic = true
deletion_protection        = false
enable_gvisor_node_pool    = false
gvisor_pool_name           = "gvisor-pool"
agent_runtime_class        = ""
enable_cert_manager        = true

image_tag                  = "latest"
image_registry             = ""
third_party_image_registry = ""

model_provider     = "gemini"
model_default_name = ""
model_max_tokens   = 0
vertex_project_id  = ""
vertex_location    = ""
vertex_manage_serving_project = true

# Gateway redaction (LITELLM_REDACTION_* in install.env). The composition
# renders nothing into the chart while enabled is false.
litellm_redaction = { enabled = false }

# The scoped service account pool (SCOPED_SA_POOL_ENABLED,
# SCOPED_SA_POOL_MAX_ACCOUNTS in install.env): one reader service account per
# project the plan lists in the scope block above, armed by this switch alone.
scoped_pool_enabled      = false

api_server_key    = "k"
gemini_api_key    = ""
openai_api_key    = ""
anthropic_api_key = ""

permission_set = "read-only"

# The projects, folders, organisations, Shared VPC hosts and Metrics Scopes
# beyond project_id whose GKE clusters get a Cluster Agent, and what to leave
# unmanaged (SCOPE_PROJECTS, SCOPE_FOLDERS, SCOPE_ORGANIZATIONS,
# SCOPE_SHARED_VPC_HOSTS, SCOPE_METRICS_SCOPES, SCOPE_MAX_PROJECTS, SCOPE_EXCLUDE_PROJECTS,
# SCOPE_EXCLUDE_CLUSTERS in install.env). Always written, so this file states
# the declaration the composition renders either way, empty lists included; an
# emptied list is the declaration that drops what it named.
scope = {
  projects         = []
  folders          = []
  organizations    = []
  shared_vpc_hosts = []
  metrics_scopes   = []
  exclude = {
    projects = []
    clusters = []
  }
}

enable_google_chat        = false
chat_topic_name           = "platform-agent-chat-events"
chat_subscription_name    = "platform-agent-chat-events-sub"
google_chat_allowed_users = []
google_chat_home_channel  = ""
google_chat_mode          = "default"

enable_slack            = false
slack_bot_token         = ""
slack_app_token         = ""
slack_allowed_users     = []
slack_home_channel      = ""
slack_home_channel_name = ""

enable_github_minter = false
github_app_id        = ""

enable_gke_backup_plan = false

# The CRD defaults dashboardEnabled to true; the installer has always
# defaulted it to false and asks. Memory settings mirror --memory.
hermes_dashboard_enabled = false
memory_enabled           = false
memory_provider          = "multiuser_memory"
user_profile_enabled     = false

# Optional AgentPlugins
enable_pubsub_platform       = false
enable_stockout_investigator = false

# Out-of-band change detection: the audit-log ingress and the consumer
# that reads it. Both, because the detector reads the subscription the
# first one provisions and the composition refuses the apply otherwise.
enable_drift_pubsub   = true
enable_drift_detector = true

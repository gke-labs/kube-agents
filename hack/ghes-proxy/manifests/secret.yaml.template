# The proxy's server certificate and key, from make-certs.sh. Rendered at run
# time with envsubst (see README.md); never commit a rendered copy.
apiVersion: v1
kind: Secret
metadata:
  name: ghes-proxy-tls
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: ghes-proxy
type: kubernetes.io/tls
data:
  tls.crt: ${TLS_CRT_B64}
  tls.key: ${TLS_KEY_B64}

# One run of the Slack live check, rendered and applied by launch.py, which also
# creates the ConfigMap holding harness.py and deletes both when the run ends. No token appears here: the harness reads them from Secret Manager
# under the ServiceAccount's Workload Identity and keeps them in memory.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: slack-live-check
    slack-live-check/run: ${RUN_ID}
spec:
  # A retry would ask for every typed turn again and judge the replies twice.
  backoffLimit: 0
  activeDeadlineSeconds: ${DEADLINE_SECONDS}
  # The launcher deletes the Job; this collects it if the launcher died first.
  ttlSecondsAfterFinished: ${TTL_SECONDS}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: slack-live-check
        slack-live-check/run: ${RUN_ID}
    spec:
      serviceAccountName: ${SERVICE_ACCOUNT}
      automountServiceAccountToken: false
      enableServiceLinks: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: harness
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          # -I ignores PYTHON* env and the user site; -B writes no bytecode, -u
          # unbuffers so a deadline kill still leaves the lines printed so far.
          command: ["python3", "-I", "-B", "-u", "/harness/harness.py"]
          args:${ARGS_YAML}
          env:
            - name: HOME
              value: /tmp
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: harness
              mountPath: /harness
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: harness
          configMap:
            name: ${CONFIGMAP_NAME}
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 16Mi

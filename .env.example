# ==============================================================================
# Local E2E & Promotion Test Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env in the repository root to configure your local test run:
#   cp .env.example .env
# Pytest and scripts/release/execute_e2e_tests.py will load it automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target GCP & GKE Cluster Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GKE_CLUSTER_NAME=platform-agent-host
GCP_REGION=us-east4
AGENT_NAMESPACE=kubeagents-system

# Which environment block in tests/e2e/e2e_config.yaml to run, and the one conftest
# reads env_vars from. Defaults to default_environment in that file (investigations-e2e).
# Name one block: "all" is a runner-only selector, and execute_e2e_tests.py expands it
# into one child per block, each told its own name. Setting it here and invoking pytest
# directly leaves conftest matching no block at all, so every env_vars fall-through --
# GITHUB_REPO, FLEET_AUDIT_STREAMS, STOCKOUT_SCENARIOS -- silently resolves to nothing.
# E2E_ENV=investigations-e2e

# Optional: Override agent local port-forward port (default: 8642)
AGENT_LOCAL_PORT=8642

# Optional: Explicit platform agent token (if secret is not auto-read via kubectl)
# PLATFORM_AGENT_TOKEN=

# ------------------------------------------------------------------------------
# 2. GitHub Integration & Fleet Audit Configuration
# ------------------------------------------------------------------------------
GITHUB_ORG=test-org-kube-agent
GITHUB_REPO=test-org-kube-agent/agents-repo
GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
#
# GITHUB_PEM_PATH is deliberately not offered here. Nothing in the E2E path reads it --
# it is install.sh's variable for importing the App key to KMS -- and both the runner and
# conftest load_dotenv() this file, so filling it in would put a path to a private key
# into the environment of every subprocess the suite spawns, `kubectl exec` included.
# The suite mints its tokens through the credential proxy instead, which is the point.

# ------------------------------------------------------------------------------
# 3. Stockout Investigation Scenarios
# ------------------------------------------------------------------------------
# Choose which scenarios to run:
#   STOCKOUT_SCENARIOS="04"        -> Fast representative promotion gate (~7m)
#   STOCKOUT_SCENARIOS="04,10"     -> Specific scenario numbers
#   STOCKOUT_SCENARIOS="all"       -> All 10 scenarios (~50-70m, Nightly Matrix)
STOCKOUT_SCENARIOS=04

# Timeout per scenario watch (seconds)
STOCKOUT_WATCH_TIMEOUT=360

# ------------------------------------------------------------------------------
# 4. Fleet Audit Live Execution
# ------------------------------------------------------------------------------
# Set to 'all' to enable live on-demand dispatch across all 7 audit streams:
# FLEET_AUDIT_LIVE=all

# ------------------------------------------------------------------------------
# 5. Google Chat / Messaging E2E (Optional)
# ------------------------------------------------------------------------------
# CHAT_TOPIC_NAME=platform-agent-chat-events
# CHAT_SPACE_ID=spaces/AAQAfrKMyng
# E2E_CHAT_CLIENT_ID=
# E2E_CHAT_CLIENT_SECRET=
# E2E_CHAT_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Container Registry for Operator / Plugin E2E (Optional)
# ------------------------------------------------------------------------------
# Defaults to $GCP_REGION-docker.pkg.dev/$GCP_PROJECT_ID/kube-agents
# REGISTRY=us-east4-docker.pkg.dev/your-gcp-project-id/kube-agents

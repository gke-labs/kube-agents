apiVersion: v1
kind: ConfigMap
metadata:
  name: github-token-minter-config
data:
  default.yaml: |
    version: 'minty.abcxyz.dev/v2'
    rule:
      if: "assertion.iss == 'https://accounts.google.com'"
    scope:
      platform-agent-scope:
        rule:
          if: "assertion.email in ['${PLATFORM_AGENT_GSA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com']"
        repositories:
          - '${GITHUB_REPO}'
        permissions:
          contents: 'write'
          pull_requests: 'write'
          issues: 'write'
          # Read-only, and read-only for one reason: the update-pr sweep asks
          # `GET /commits/{sha}/check-runs` and `/commits/{sha}/status` which
          # checks are red before it decides whether a pull request needs a
          # card. Without these the App gets 403 on both, forge.py raises
          # REPO_UNREACHABLE, and the sweep drops the pull request entirely --
          # the merge-conflict card with it, since one `try` covers both reads.
          checks: 'read'
          statuses: 'read'
  ${GITHUB_REPO}.yaml: |
    version: 'minty.abcxyz.dev/v2'
    rule:
      if: "assertion.iss == 'https://accounts.google.com'"
    scope:
      platform-agent-scope:
        rule:
          if: "assertion.email in ['${PLATFORM_AGENT_GSA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com']"
        repositories:
          - '${GITHUB_REPO}'
        permissions:
          contents: 'write'
          pull_requests: 'write'
          issues: 'write'
          # Read-only, and read-only for one reason: the update-pr sweep asks
          # `GET /commits/{sha}/check-runs` and `/commits/{sha}/status` which
          # checks are red before it decides whether a pull request needs a
          # card. Without these the App gets 403 on both, forge.py raises
          # REPO_UNREACHABLE, and the sweep drops the pull request entirely --
          # the merge-conflict card with it, since one `try` covers both reads.
          checks: 'read'
          statuses: 'read'
